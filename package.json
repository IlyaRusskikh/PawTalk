{
  "name": "pawtalk-workspace",
  "private": true,
  "description": "PawTalk monorepo build and development commands",
  "author": "PawTalk contributors",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "apps/client/windows/electron/main.cjs",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "dev": "node apps/client/windows/scripts/dev.mjs",
    "review": "npm run build && electron apps/client/windows/scripts/review.cjs",
    "dev:web": "node apps/client/windows/scripts/prepare-rnnoise.mjs && vite --host 127.0.0.1",
    "build": "node tooling/build/prepare-licenses.mjs && node apps/client/windows/scripts/prepare-rnnoise.mjs && tsc --noEmit -p apps/client/windows/tsconfig.json && vite build",
    "test": "node --test apps/client/windows/tests/*.test.mjs apps/manager/windows/tests/*.test.mjs tests/infrastructure/*.test.mjs tests/compatibility/*.test.mjs tests/release/*.test.mjs",
    "smoke": "node apps/client/windows/scripts/server-chat-ui-smoke.mjs && node apps/client/windows/scripts/reorder-ui-smoke.mjs && node apps/client/windows/scripts/reorder-ui-smoke.mjs apps/client/windows/tests/review-followup-ui.cjs && node apps/client/windows/scripts/membership-app-smoke.mjs --audio",
    "test:connection-ui": "node apps/client/windows/scripts/connection-ui-smoke.mjs",
    "test:chat-ui": "node apps/client/windows/scripts/membership-app-smoke.mjs",
    "test:chat-features": "node apps/client/windows/scripts/server-chat-ui-smoke.mjs",
    "test:external-links": "node apps/client/windows/scripts/external-links-smoke.mjs",
    "test:chat-main": "node apps/client/windows/scripts/membership-app-smoke.mjs",
    "test:sounds": "node apps/client/windows/scripts/sounds-smoke.mjs",
    "test:docker": "node apps/server/scripts/docker-smoke.mjs",
    "test:server": "node apps/server/scripts/server-smoke.mjs --audio",
    "test:e2ee": "node apps/client/windows/scripts/membership-app-smoke.mjs --audio",
    "test:e2ee:main": "node apps/client/windows/scripts/membership-app-smoke.mjs",
    "native:build": "node-gyp rebuild --directory apps/client/windows/native",
    "dev:server": "node tooling/dev/dev-server.mjs",
    "package": "npm run server:prepare && npm run build && electron-builder --config apps/client/windows/electron-builder.cjs --win nsis --x64 --publish never",
    "package:dir": "npm run server:prepare && npm run build && electron-builder --config apps/client/windows/electron-builder.cjs --win dir --x64 --publish never",
    "server:prepare": "node tooling/build/prepare-server.mjs",
    "icons:generate": "node apps/client/windows/scripts/generate-icons.cjs",
    "check:public": "node tooling/ci/check-public.mjs",
    "licenses:prepare": "node tooling/build/prepare-licenses.mjs",
    "review:server": "node tooling/dev/review-server.mjs"
  },
  "dependencies": {
    "@shiguredo/rnnoise-wasm": "2025.1.5",
    "@silentbot1/nat-api": "0.4.9",
    "livekit-client": "2.23.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "node-addon-api": "8.9.2",
    "node-gyp": "13.1.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "workspaces": [
    "apps/client/windows",
    "apps/manager/windows/desktop"
  ]
}
