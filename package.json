{
  "name": "pawtalk",
  "version": "0.5.2",
  "private": true,
  "description": "Private, self-hosted voice room for Windows",
  "author": "PawTalk contributors",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "review": "npm run build && electron scripts/review.cjs",
    "dev:web": "node scripts/prepare-rnnoise.mjs && vite --host 127.0.0.1",
    "build": "node scripts/prepare-licenses.mjs && node scripts/prepare-rnnoise.mjs && tsc --noEmit && vite build",
    "test": "node --test tests/*.test.mjs",
    "smoke": "electron scripts/smoke.cjs",
    "test:chat-ui": "node scripts/chat-ui-smoke.mjs",
    "test:chat-main": "node scripts/chat-main-smoke.mjs",
    "test:sounds": "node scripts/sounds-smoke.mjs",
    "test:docker": "node scripts/docker-smoke.mjs",
    "test:server": "node scripts/server-smoke.mjs --audio",
    "test:e2ee": "node scripts/e2ee-benchmark.mjs --security-only",
    "test:e2ee:main": "node scripts/e2ee-main-smoke.mjs",
    "bench:e2ee": "node scripts/e2ee-benchmark.mjs",
    "bench:latency": "node scripts/e2ee-benchmark.mjs --latency --contexts",
    "native:build": "node-gyp rebuild --directory native",
    "configure": "node scripts/configure.mjs",
    "package": "npm run server:prepare && npm run build && electron-builder --win nsis --x64 --publish never",
    "package:dir": "npm run server:prepare && npm run build && electron-builder --win dir --x64 --publish never",
    "server:prepare": "node scripts/prepare-server.mjs",
    "icons:generate": "node scripts/generate-icons.cjs",
    "check:public": "node scripts/check-public.mjs",
    "licenses:prepare": "node scripts/prepare-licenses.mjs"
  },
  "dependencies": {
    "@shiguredo/rnnoise-wasm": "2025.1.5",
    "@silentbot1/nat-api": "0.4.9",
    "livekit-client": "2.23.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "node-addon-api": "8.9.2",
    "node-gyp": "13.1.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "build": {
    "appId": "local.pawtalk.desktop",
    "productName": "PawTalk",
    "protocols": [
      {
        "name": "Приглашение PawTalk",
        "schemes": [
          "pawtalk"
        ]
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "shared/**/*",
      "package.json",
      "THIRD_PARTY_NOTICES.md",
      "licenses/**/*",
      "assets/**/*",
      "LICENSE"
    ],
    "extraResources": [
      {
        "from": "scripts/check-selfhost.ps1",
        "to": "diagnostics/check-selfhost.ps1"
      },
      {
        "from": "native/build/Release/pawtalk.node",
        "to": "pawtalk.node"
      },
      {
        "from": "resources/server",
        "to": "server",
        "filter": [
          "*.exe",
          "*LICENSE*"
        ]
      },
      {
        "from": "scripts/install-update.ps1",
        "to": "updates/install-update.ps1"
      }
    ],
    "npmRebuild": false,
    "win": {
      "target": "nsis",
      "signAndEditExecutable": true,
      "icon": "assets/pawtalk.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/pawtalk.ico",
      "uninstallerIcon": "assets/pawtalk.ico",
      "installerLanguages": [
        "en_US",
        "ru_RU"
      ],
      "displayLanguageSelector": true,
      "include": "build/installer.nsh",
      "deleteAppDataOnUninstall": false
    }
  }
}
