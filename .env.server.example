# Legacy Compose example for local use. For VPS use .env.server.swarm.example.
# The selected image must already be published and public in GHCR.
PAWTALK_IMAGE=ghcr.io/ilyarusskikh/pawtalk-server:0.5.2
PAWTALK_PUBLIC_IP=203.0.113.10
PAWTALK_PORT=18443

# Experimental E2EE is optional. See docs/E2EE.md before enabling it.
PAWTALK_E2EE=false
PAWTALK_E2EE_KEY_ID=

# Chat SQLite size in MiB, including messages, profiles, indexes and images.
# Oldest messages are removed to fit. 0 = unlimited; no time-based expiry.
PAWTALK_CHAT_MAX_MB=128

# Stream client updates from GitHub for users with restricted GitHub access.
# No installer files are stored; false disables the relay.
PAWTALK_UPDATE_PROXY=true
