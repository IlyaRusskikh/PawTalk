# For local review, build the server and set VOICECORD_IMAGE=voicecord-server:review.
# Use an actually published version on the VPS.
VOICECORD_IMAGE=ghcr.io/ilyarusskikh/voicecord-server:0.5.0
VOICECORD_RELEASE=0.5.0
VOICECORD_PUBLIC_IP=203.0.113.10
VOICECORD_PORT=18443
VOICECORD_E2EE=false
VOICECORD_E2EE_KEY_ID=
# Reuse the existing Compose volume during migration. Never delete it.
VOICECORD_DATA_VOLUME=voicecord-server_server_data
# Disabled unless explicitly enabled. check works even when this is false.
VOICECORD_AUTO_UPDATE=false
# stable excludes pre-releases; preview includes them (Voicecord 0.x releases).
VOICECORD_UPDATE_CHANNEL=preview
VOICECORD_UPDATE_REPOSITORY=IlyaRusskikh/voicecord

# Chat SQLite size in MiB, including messages, profiles, indexes and images.
# Oldest messages are removed to fit. 0 = unlimited; no time-based expiry.
VOICECORD_CHAT_MAX_MB=128
