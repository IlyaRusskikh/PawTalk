# Trust this Caddy CA on both clients for a two-computer LAN prototype.
{
	admin localhost:2019
	default_sni {$SERVER_IP}
}
https://{$SERVER_HOST} {
	tls internal
	@api path /api/* /healthz
	handle @api {
		reverse_proxy 127.0.0.1:8080 {
			header_up X-Real-IP {remote_host}
		}
	}
	handle_path /rtc* {
		reverse_proxy 127.0.0.1:7880
	}
}
