[Unit]
Description=Check and update PawTalk Swarm service when enabled
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/pawtalk
ExecStart=/usr/bin/python3 /opt/pawtalk/scripts/server-update.py update --config /opt/pawtalk/.env --stack pawtalk
TimeoutStartSec=15min
UMask=0077
